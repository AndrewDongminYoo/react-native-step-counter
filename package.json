{
  "name": "react-native-step-counter-newarch",
  "version": "0.5.0",
  "description": "This library provides an interface for tracking the number of steps taken by the user in a React Native app.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace com.stepcounter.example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build example/ios/Pods lib",
    "test": "jest --runInBand --no-watchman",
    "prepare": "bob build",
    "typecheck": "tsc",
    "watchman-reset": "watchman watch-del $PWD && watchman watch-project $PWD"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewDongminYoo/react-native-step-counter.git"
  },
  "author": "Dongmin, Yoo <ydm2790@gmail.com> (https://github.com/AndrewDongminYoo)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AndrewDongminYoo/react-native-step-counter/issues"
  },
  "homepage": "https://github.com/AndrewDongminYoo/react-native-step-counter#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
